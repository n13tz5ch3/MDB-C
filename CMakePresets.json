{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "MDB_VERSION_43": "ON",
        "MDB_VERBOSE_LOGGING": "ON",
        "MDB_TTY_DEVICE": "/dev/ttyUSB0",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "MDB_VERSION_43": "ON",
        "MDB_VERBOSE_LOGGING": "OFF",
        "MDB_TTY_DEVICE": "/dev/ttyUSB0",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-arm-debug",
      "displayName": "Linux ARM Debug (Cross)",
      "inherits": "default",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MDB_VERSION_43": "ON",
        "MDB_VERBOSE_LOGGING": "ON",
        "MDB_TTY_DEVICE": "/dev/ttyAMA0",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-arm-release",
      "displayName": "Linux ARM Release (Cross)",
      "inherits": "default",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MDB_VERSION_43": "ON",
        "MDB_VERBOSE_LOGGING": "OFF",
        "MDB_TTY_DEVICE": "/dev/ttyAMA0",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "MDB_VERSION_43": "ON",
        "MDB_VERBOSE_LOGGING": "ON",
        "MDB_TTY_DEVICE": "/dev/cu.usbserial",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "MDB_VERSION_43": "ON",
        "MDB_VERBOSE_LOGGING": "OFF",
        "MDB_TTY_DEVICE": "/dev/cu.usbserial",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "raspberry-pi",
      "displayName": "Raspberry Pi (Native)",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "MDB_VERSION_43": "ON",
        "MDB_VERBOSE_LOGGING": "OFF",
        "MDB_TTY_DEVICE": "/dev/ttyAMA0",
        "BUILD_EXAMPLES": "ON",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "embedded-minimal",
      "displayName": "Embedded Minimal (Callback only)",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "MDB_VERSION_43": "ON",
        "MDB_VERBOSE_LOGGING": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug",
      "jobs": 8
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release",
      "jobs": 8
    },
    {
      "name": "linux-arm-debug",
      "configurePreset": "linux-arm-debug",
      "jobs": 8
    },
    {
      "name": "linux-arm-release",
      "configurePreset": "linux-arm-release",
      "jobs": 8
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "jobs": 8
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "jobs": 8
    },
    {
      "name": "raspberry-pi",
      "configurePreset": "raspberry-pi",
      "jobs": 4
    },
    {
      "name": "embedded-minimal",
      "configurePreset": "embedded-minimal",
      "jobs": 8
    }
  ]
}
